# =============================================================================
# 创客星球 (PCG Maker Planet) — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `app/.env` for local development, and configure the same
# variables in your hosting provider (e.g. Vercel Project Settings) for prod.
#
#   cp .env.example app/.env
#
# ⚠️  NEVER commit real keys. `app/.env` is git-ignored by design.
# =============================================================================

# --- GLM (Zhipu AI) credentials --------------------------------------------
# Server-side only. The browser never sees this key; all model calls are
# proxied through the serverless functions in /api/glm/*.
GLM_API_KEY=your_glm_api_key_here
VITE_GLM_API_KEY=your_glm_api_key_here

# --- Model configuration ----------------------------------------------------
VITE_GLM_MODEL=glm-4.7-flashx
VITE_GLM_FALLBACK_MODEL=glm-4.7
VITE_GLM_IMAGE_MODEL=glm-image

# --- GLM API base URL -------------------------------------------------------
VITE_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
